# Both of these are OPTIONAL. The app works fully without them,
# saving all data to the browser's localStorage (per-device).

# 1) To enable real-time cloud sync across multiple devices/users,
#    create a free Firebase project (https://console.firebase.google.com),
#    enable Firestore + Anonymous Auth, and paste your web config here
#    as a single-line JSON string:
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# VITE_APP_ID=my-factory-qms

# 2) To enable the "AI Daily Report" feature, add a Gemini API key
#    from https://aistudio.google.com/apikey
# VITE_GEMINI_API_KEY=
